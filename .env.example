# Copy to .env, then generate both values using the commands in README.md.
DJANGO_SECRET_KEY=
DB_PASSWORD=
DB_NAME=suppression
DB_USER=suppression
# Local HTTP only. For production set DEBUG=0 and serve through HTTPS.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080
APP_PORT=18080
APP_BIND=127.0.0.1
TRUST_PROXY_HTTPS=0
SECURE_SSL_REDIRECT=0
# Keep blank locally. Production safety alerts are delivered to this Discord URL.
DISCORD_WEBHOOK_URL=
BATCH_LOOKUP_INTERVAL=1
BATCH_ACCEL_DOWNLOADS=1
BATCH_MAX_UPLOAD_BYTES=104857600
BATCH_MAX_NUMBERS=1000000
BATCH_MAX_OPEN_FILES=10
